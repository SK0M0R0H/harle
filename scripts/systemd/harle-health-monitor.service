# User systemd oneshot: health check + disk usage monitor with Telegram alerts.
# Install: copy to ~/.config/systemd/user/ and adjust paths below.
#
#   mkdir -p ~/.config/systemd/user
#   cp scripts/systemd/harle-health-monitor.service ~/.config/systemd/user/
#   cp scripts/systemd/harle-health-monitor.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   loginctl enable-linger "$USER"
#   systemctl --user enable --now harle-health-monitor.timer
#
# Required in EnvironmentFile (.env): HARLE_TELEGRAM_ALERT_BOT_TOKEN, HARLE_TELEGRAM_ALERT_CHAT_ID.
# Optional: HARLE_DISK_WARN_PCT, HEALTH_MONITOR_LOG_FILE, HARLE_API_URL, HARLE_STATE_DIR,
# HARLE_DEPLOY_IN_PROGRESS_FILE, HARLE_DEPLOY_LOCK_MAX_AGE_SEC.

[Unit]
Description=Harle health monitor (API health check, disk usage, Telegram alerts)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/harle
EnvironmentFile=-%h/harle/.env
ExecStart=%h/harle/scripts/health-monitor.sh

[Install]
WantedBy=default.target
