# Copy to .env and fill with your deployment credentials.
# Harle loads this file automatically at startup.
# Process environment variables override values in this file.

# --- Deployment ---
# Internal Docker network URL (db service hostname is "db").
DATABASE_URL=postgresql+psycopg2://harle:changeme@db:5432/harle
# Path where the container reads and writes vault files.
HARLE_DATASET_PATH=/data/vault
# Docker Compose + vault-sync: host directory bind-mounted into the container as HARLE_DATASET_PATH.
# Local dev: ./vault. Remote server: absolute path to a git checkout (see docs/runbooks/remote-setup.md §12).
HARLE_VAULT_PATH=./vault
# Base URL for scripts/vault-sync.sh, harle-cli, and harle-telegram (host loopback → published container port).
HARLE_API_URL=http://127.0.0.1:8000

# --- Telegram chat bot (Stage 1) ---
# Dedicated BotFather token for the assistant bot (not the alert bot below).
# HARLE_TELEGRAM_BOT_TOKEN=
# Who may use the bot: allowlist (default, safest) or open (any user — dev only).
# HARLE_TELEGRAM_ACCESS_POLICY=allowlist
# Comma-separated Telegram numeric user IDs when policy is allowlist.
# HARLE_TELEGRAM_ALLOWED_USER_IDS=
# API authentication (optional locally; recommended for remote). When set, Harle requires
# Authorization: Bearer <token> on all routes except /health*. Generate e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use the same value in ~/.config/harle/cli.yaml (api_token) and vault-sync EnvironmentFile.
# HARLE_API_TOKEN=
# Server bind host inside the container.
HARLE_HOST=0.0.0.0
# Docker Compose only: host bind for published port 8000 (not the same as HARLE_HOST inside the container).
# - 127.0.0.1 (default): API reachable only on the host loopback — local dev, or a remote VPS when you use
#   an SSH tunnel (-L 8000:127.0.0.1:8000) and do not open :8000 on the firewall.
# - 0.0.0.0: API on all host interfaces — use on a VPS when another machine hits http://<server-ip>:8000
#   (public IP after server-init, or Tailscale/LAN IP after optional hardening); requires matching UFW rules.
HARLE_PUBLISH_HOST=127.0.0.1
# Database settings used by docker-compose.yml.
POSTGRES_USER=harle
POSTGRES_PASSWORD=changeme
POSTGRES_DB=harle

# --- Continuous deployment (Phase 4) ---
# Image tag for deploy-pull.sh (default: latest). Set to sha-<commit> to pin a specific version
# for rollback; reset to "latest" to resume automatic deploys.
# HARLE_IMAGE_TAG=latest
# Log file for deploy-pull.sh (default: ~/deploy-pull.log).
# DEPLOY_LOG_FILE=~/deploy-pull.log

# --- Monitoring and alerting (Phase 5) ---
# Telegram bot token for health and disk alerts. Create via @BotFather on Telegram.
# HARLE_TELEGRAM_ALERT_BOT_TOKEN=
# Telegram chat ID to receive alerts. Find via @userinfobot or the getUpdates API.
# HARLE_TELEGRAM_ALERT_CHAT_ID=
# Disk usage warning threshold (percent). Alert fires when root partition exceeds this.
# HARLE_DISK_WARN_PCT=85
# Log file for health-monitor.sh (default: ~/health-monitor.log).
# HEALTH_MONITOR_LOG_FILE=~/health-monitor.log
# Shared state dir for health-monitor + deploy-pull lock file (default: /tmp).
# HARLE_STATE_DIR=/tmp
# While deploy-pull.sh restarts harle, it touches this lock; health-monitor skips DOWN alerts (default: $HARLE_STATE_DIR/harle-deploy-in-progress).
# HARLE_DEPLOY_IN_PROGRESS_FILE=
# Stale lock removal if older than this many seconds (default: 900).
# HARLE_DEPLOY_LOCK_MAX_AGE_SEC=900

# --- Database backup (Phase 5) ---
# S3-compatible bucket for off-site backups. Omit to keep backups local only.
# HARLE_BACKUP_S3_BUCKET=
# Custom S3 endpoint for non-AWS providers (Backblaze B2, Hetzner, MinIO). Omit for AWS S3.
# Example Backblaze B2: https://s3.us-west-004.backblazeb2.com
# HARLE_BACKUP_S3_ENDPOINT=
# How many days to keep backups in S3 (default: 7).
# HARLE_BACKUP_RETENTION_DAYS=7
# Local staging directory for backup files (default: ~/harle-backups).
# HARLE_BACKUP_DIR=~/harle-backups
# Log file for db-backup.sh (default: ~/db-backup.log).
# DB_BACKUP_LOG_FILE=~/db-backup.log
# Usage report window in days for usage-report.sh (default: 7).
# HARLE_USAGE_REPORT_DAYS=7
# Log file for usage-report.sh (default: ~/usage-report.log).
# USAGE_REPORT_LOG_FILE=~/usage-report.log

# --- API keys ---
OPENAI_API_KEY=
TAVILY_API_KEY=

# --- Optional integrations ---
TRELLO_API_KEY=
TRELLO_API_TOKEN=
NOTION_API_TOKEN=

# Optional: use when your dotenv file is not in the project root.
# HARLE_DOTENV_PATH=/absolute/path/to/.env
